{
  "firestore": {
    "rules": "Firebase/firestore.rules"
  },
  "storage": {
    "rules": "Firebase/storage.rules"
  },
  "functions": [
    {
      "source": "Firebase/functions",
      "codebase": "export-bridge",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firestore-debug.log"
      ]
    },
    {
      "source": "functions",
      "codebase": "gemini-proxy",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firestore-debug.log"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
